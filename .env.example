# Origin API. Пусто — тот же origin: в dev /api проксирует Vite на API_TARGET
VITE_API_ORIGIN=
API_TARGET=http://127.0.0.1:8000

# Keycloak: realm и публичный клиент SPA (Authorization Code + PKCE)
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=tiu-media-hub
VITE_KEYCLOAK_CLIENT_ID=tiu-media-hub-web

# Ссылка «Связаться с пресс-службой» на публичных порталах. Пусто — ссылка скрыта
VITE_PRESS_CONTACT_URL=
